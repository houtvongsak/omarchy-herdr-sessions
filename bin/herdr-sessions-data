#!/bin/bash
# herdr-sessions-data — what the session picker needs to know about other machines, as JSON.
#
#   list               the machines to look on, at once:
#                      {"host": ..., "version": ..., "machines": [{target, key}]}
#   machines           every machine's herdr sessions and version, fetched over SSH in parallel:
#                      [{target, key, label, version, ok, error, sessions: [...]}]
#   local              this computer's sessions, as `herdr session list --json`, without the
#                      empty folders `herdr --remote --session X` leaves behind for its client log
#   attached           the sessions this computer's herdr clients are showing: [{key, session}]
#                      (key is "" for a local session)
#   stop <target> <session>     stop a session on a machine
#   delete <target> <session>   delete a stopped session on a machine
#   add <target>       add a machine to the list
#   remove <target>    take a machine off the list
#
# Machines come from ~/.config/herdr-sessions/machines (one SSH target per line, # for comments)
# plus every enabled machine saved with `herdr machine add`. A `-target` line hides a machine
# saved in herdr without touching herdr's own list. A target that is this computer is
# skipped, so one list can be shared by several machines. Each machine needs non-interactive SSH
# (a key, no password prompt) and herdr; `~/.local/bin` is searched, where herdr installs itself.
set -uo pipefail

list_file=${HERDR_SESSIONS_MACHINES:-$HOME/.config/herdr-sessions/machines}
remote_path='PATH="$HOME/.local/bin:$HOME/.cargo/bin:/usr/local/bin:$PATH"'
ssh_opts=(-T -o BatchMode=yes -o ConnectTimeout=5)
self=$(uname -n)
self=${self%%.*}

# user@host, a Host from ~/.ssh/config, or an ssh:// URL as herdr itself accepts.
valid_target() { [[ $1 =~ ^(ssh://)?[A-Za-z0-9][A-Za-z0-9@._:-]*$ ]]; }
valid_session() { [[ $1 =~ ^[A-Za-z0-9._-]{1,64}$ && $1 != . && $1 != .. ]]; }

# One name per machine, whichever way it is written: user@host, an ssh alias or the full
# Tailscale name all become the short host name ssh would connect to, in lower case.
machine_key() {
  local host
  host=$(ssh -G -- "$1" 2>/dev/null | awk '$1 == "hostname" {print $2; exit}')
  if [[ -z $host ]]; then
    host=${1#ssh://}
    host=${host#*@}
    host=${host%%:*}
  fi
  host=${host%%.*}
  echo "${host,,}"
}

list_lines() { [[ -f $list_file ]] && sed 's/#.*//' "$list_file" | awk 'NF {print $1}'; }
saved_targets() { herdr machine list --json 2>/dev/null | jq -r '.[]? | select(.enabled) | .target'; }

targets() {
  local hidden
  hidden=$(list_lines | sed -n 's/^-//p')
  {
    list_lines | grep -v '^-'
    saved_targets
  } | awk '!seen[$0]++' | while read -r target; do
    valid_target "$target" || continue
    grep -qxF -- "$target" <<<"$hidden" && continue
    key=$(machine_key "$target")
    [[ $key == "${self,,}" || $key == localhost ]] && continue
    printf '%s\t%s\n' "$target" "$key"
  done | awk -F'\t' '!seen[$2]++' # two names for one machine make one tab
}

cmd_list() {
  targets | jq -R -s --arg host "$self" --arg version "$(herdr_version herdr --version)" '
    {host: $host, version: $version, machines: [split("\n")[] | select(length > 0) | split("\t") | {target: .[0], key: .[1]}]}'
}

# "herdr 0.9.3" -> "0.9.3"; empty when herdr can't say.
herdr_version() { "$@" 2>/dev/null | awk '{v = $NF; if (v ~ /^v?[0-9]/) print v; exit}'; }

fetch() { # <target> <key> <outfile>
  local target=$1 key=$2 out rc host version json error
  out=$(timeout 10 ssh "${ssh_opts[@]}" -- "$target" \
    "$remote_path; echo @@host; hostname; echo @@version; herdr --version; echo @@json; herdr session list --json" 2>&1 | tr -d '\r')
  rc=${PIPESTATUS[0]}
  # Markers, because a shell startup file on the far side may print something of its own.
  host=$(awk '/^@@host$/ {getline; print; exit}' <<<"$out")
  version=$(herdr_version awk '/^@@version$/ {getline; print; exit}' <<<"$out")
  json=$(awk 'f; /^@@json$/ {f = 1}' <<<"$out")
  if ((rc == 0)) && jq -e '.sessions | type == "array"' >/dev/null 2>&1 <<<"$json"; then
    jq -c --arg target "$target" --arg key "$key" --arg label "${host:-$target}" --arg version "$version" \
      '{target: $target, key: $key, label: $label, version: $version, ok: true, error: "", sessions: .sessions}' <<<"$json" >"$3"
  else
    error=$(grep -v -E '^@@|^\s*$' <<<"$out" | tail -1)
    ((rc == 124)) && error="no answer within 10 seconds"
    jq -nc --arg target "$target" --arg key "$key" --arg version "$version" --arg error "${error:-ssh exited $rc}" \
      '{target: $target, key: $key, label: $target, version: $version, ok: false, error: $error, sessions: []}' >"$3"
  fi
}

# `herdr --remote T --session X` logs into ~/.config/herdr/sessions/X on this computer, and
# `session list` then shows X as a stopped local session that never existed here. A session
# that ever ran has a server log or saved state; one with neither is only that log folder.
cmd_local() {
  local json ghosts=() dir name
  json=$(herdr session list --json) || return 1
  while IFS=$'\t' read -r name dir; do
    [[ -e $dir/herdr-server.log || -e $dir/session.json ]] || ghosts+=("$name")
  done < <(jq -r '.sessions[] | select(.running | not) | [.name, .session_dir] | @tsv' <<<"$json")
  jq --args '.sessions |= map(select(.name as $n | $ARGS.positional | index($n) | not))' "${ghosts[@]}" <<<"$json"
}

cmd_machines() {
  local i=0 target key
  tmp_dir=$(mktemp -d) || exit 1
  trap 'rm -rf "$tmp_dir"' EXIT
  while IFS=$'\t' read -r target key; do
    fetch "$target" "$key" "$tmp_dir/$(printf '%03d' $i)" &
    i=$((i + 1))
  done < <(targets)
  wait
  cat "$tmp_dir"/* 2>/dev/null | jq -s '.'
}

# herdr clients on this computer: `herdr`, `herdr --session X`, `herdr session attach X` and
# `herdr --remote T [--session X]`. Servers and every other subcommand are left out.
cmd_attached() {
  ps -eo args= | while read -r -a argv; do
    [[ ${argv[0]##*/} == herdr ]] || continue
    local session=default remote="" i=1 client=1
    while ((i < ${#argv[@]})); do
      case ${argv[i]} in
        --session) session=${argv[i + 1]:-}; i=$((i + 2)) ;;
        --session=*) session=${argv[i]#*=}; i=$((i + 1)) ;;
        --remote) remote=${argv[i + 1]:-}; i=$((i + 2)) ;;
        --remote=*) remote=${argv[i]#*=}; i=$((i + 1)) ;;
        --remote-keybindings) i=$((i + 2)) ;;
        --handoff) i=$((i + 1)) ;;
        session)
          if [[ ${argv[i + 1]:-} == attach && -n ${argv[i + 2]:-} ]]; then
            session=${argv[i + 2]}; i=$((i + 3))
          else
            client=0; break
          fi
          ;;
        *) client=0; break ;;
      esac
    done
    ((client)) || continue
    if [[ -n $remote ]]; then
      valid_target "$remote" || continue
      remote=$(machine_key "$remote")
    fi
    printf '%s\t%s\n' "$remote" "$session"
  done | sort -u | jq -R -s '[split("\n")[] | select(length > 0) | split("\t") | {key: .[0], session: .[1]}]'
}

remote_session_command() { # <target> <command...>
  local target=$1
  shift
  valid_target "$target" || { echo "invalid target: $target" >&2; exit 2; }
  timeout 15 ssh "${ssh_opts[@]}" -- "$target" "$remote_path; $*"
}

cmd_stop() {
  valid_session "${2:-}" || { echo "invalid session: ${2:-}" >&2; exit 2; }
  if [[ $2 == default ]]; then
    remote_session_command "$1" herdr server stop
  else
    remote_session_command "$1" herdr session stop "$2"
  fi
}

cmd_delete() {
  valid_session "${2:-}" && [[ $2 != default ]] || { echo "invalid session: ${2:-}" >&2; exit 2; }
  remote_session_command "$1" herdr session delete "$2"
}

# Rewrites the list without the exact line given; in place, so a linked file stays a link.
drop_line() {
  [[ -f $list_file ]] || return 0
  local kept
  kept=$(grep -vxF -- "$1" "$list_file")
  printf '%s\n' "$kept" | sed '/^$/d' >"$list_file"
}

cmd_add() {
  valid_target "${1:-}" || { echo "invalid target: ${1:-}" >&2; exit 2; }
  mkdir -p "$(dirname "$list_file")"
  drop_line "-$1" # showing a hidden herdr machine again
  saved_targets | grep -qxF -- "$1" && return 0
  grep -qxF -- "$1" "$list_file" 2>/dev/null && return 0
  echo "$1" >>"$list_file" # appending keeps the file a link if omarchy-config made it one
}

# A machine from the list file is dropped from it; one saved in herdr is hidden with a
# `-target` line, so herdr's own machine list is left as it is.
cmd_remove() {
  valid_target "${1:-}" || { echo "invalid target: ${1:-}" >&2; exit 2; }
  drop_line "$1"
  if saved_targets | grep -qxF -- "$1"; then
    mkdir -p "$(dirname "$list_file")"
    grep -qxF -- "-$1" "$list_file" 2>/dev/null || echo "-$1" >>"$list_file"
  fi
}

case ${1:-} in
  list) cmd_list ;;
  local) cmd_local ;;
  machines) cmd_machines ;;
  attached) cmd_attached ;;
  stop) cmd_stop "${2:-}" "${3:-}" ;;
  delete) cmd_delete "${2:-}" "${3:-}" ;;
  add) cmd_add "${2:-}" ;;
  remove) cmd_remove "${2:-}" ;;
  *) sed -n '2,20p' "$0" >&2; exit 2 ;;
esac
